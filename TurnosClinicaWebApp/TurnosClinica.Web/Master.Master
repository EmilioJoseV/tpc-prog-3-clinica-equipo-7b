<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Master.Master.cs" Inherits="TurnosClinica.Web.MasterLayout" %>

<!DOCTYPE html>

<html>
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Turnos Clinica</title>
    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body>
    <form id="form1" runat="server" enctype="multipart/form-data">
        <asp:ScriptManager ID="ScripManager1" runat="server">

        </asp:ScriptManager>

        <nav class="navbar navbar-expand-lg bg-dark navbar-dark shadow-sm">
            <div class="container-fluid">
                <a class="navbar-brand fw-semibold" href="/Inicio.aspx">Turnos Clinica</a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarSupportedContent">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item me-2">
                            <asp:HyperLink ID="LnkPanelPrincipal" runat="server"
                                CssClass="btn btn-outline-light"
                                NavigateUrl="~/PanelPrincipal.aspx">Panel principal</asp:HyperLink>
                        </li>
                    </ul>

                    <ul class="navbar-nav ms-auto mb-2 mb-lg-0 align-items-center">
                        <li id="ItemUsuario" runat="server" class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle d-flex align-items-center gap-2" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <asp:Image ID="imgAvatar" runat="server" Width="40" Height="40"
                                    CssClass="rounded-circle object-fit-cover" />
                            <asp:Label ID="lblAvatarPlaceholder" runat="server" Width="40" Height="40"
                                    CssClass="rounded-circle bg-secondary text-white d-inline-flex align-items-center justify-content-center" />
                                <span class="d-flex flex-column lh-sm">
                                    <asp:Label ID="LblNombreUsuario" runat="server" CssClass="text-white" />
                                    <asp:Label ID="LblRolUsuario" runat="server" CssClass="text-white-50 small" />
                                </span>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li>
                                    <asp:HyperLink ID="LnkMiPerfil" runat="server" CssClass="dropdown-item"
                                        NavigateUrl="~/Perfil/MiPerfil.aspx">Mi Perfil</asp:HyperLink>
                                </li>
                                <li><hr class="dropdown-divider" /></li>
                                <li>
                                    <asp:LinkButton ID="LnkSalir" runat="server" CssClass="dropdown-item" Text="Salir" OnClick="LnkSalir_Click" />
                                </li>
                            </ul>
                        </li>
                        <li class="nav-item">
                            <asp:HyperLink ID="LnkIngresar" runat="server" CssClass="btn btn-warning text-dark" NavigateUrl="~/Ingresar.aspx">Ingresar</asp:HyperLink>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>

        <div class="container py-4">
            <asp:Panel ID="PnlMensajeError" runat="server" Visible="false" EnableViewState="false"
                CssClass="alert alert-danger alert-dismissible fade show" role="alert">
                <strong>No se pudo completar la operacion</strong>
                <asp:Label ID="LblMensajeError" runat="server" CssClass="d-block mt-1" />
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
            </asp:Panel>
            <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
            </asp:ContentPlaceHolder>
        </div>
    </form>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
