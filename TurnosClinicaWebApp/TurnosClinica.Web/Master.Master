<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Master.Master.cs" Inherits="TurnosClinica.Web.MasterLayout" %>

<!DOCTYPE html>

<html>
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Turnos Clinica</title>
    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body>
    <form id="form1" runat="server" enctype="multipart/form-data">
        <asp:ScriptManager ID="ScripManager1" runat="server">

        </asp:ScriptManager>

        <nav class="navbar navbar-expand-lg bg-dark navbar-dark">
            <div class="container-fluid">
                <a class="navbar-brand" href="/Inicio.aspx">Turnos Clinica</a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarSupportedContent">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <asp:HyperLink ID="LnkPanelPrincipal" runat="server"
                                CssClass="btn btn-warning text-dark"
                                NavigateUrl="~/PanelPrincipal.aspx">Panel principal</asp:HyperLink>
                        </li>
                    </ul>

                    <ul class="navbar-nav ms-auto mb-2 mb-lg-0">
                        <li class="nav-item"><a class="nav-link" href="/Perfil/MiPerfil.aspx">Mi Perfil</a></li>
                        <li class="nav-item">
                            <asp:HyperLink ID="LnkIngresar" runat="server" CssClass="nav-link" NavigateUrl="~/Ingresar.aspx">Ingresar</asp:HyperLink>
                        </li>
                        <li class="nav-item">
                            <asp:LinkButton ID="LnkSalir" runat="server" CssClass="nav-link" Text="Salir" OnClick="LnkSalir_Click" />
                        </li>
                    </ul>
                </div>
            </div>
        </nav>

        <div class="container">
            <hr />
            <asp:Panel ID="PnlMensajeError" runat="server" Visible="false" EnableViewState="false"
                CssClass="alert alert-danger alert-dismissible fade show" role="alert">
                <strong>No se pudo completar la operacion</strong>
                <asp:Label ID="LblMensajeError" runat="server" CssClass="d-block mt-1" />
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
            </asp:Panel>
            <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
            </asp:ContentPlaceHolder>
        </div>
    </form>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
